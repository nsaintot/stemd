# Rust build output (several GB)
target/

# Editor-local preferences
.vscode/

# Python build tooling is tracked, not ignored. Nothing Python ships, builds or
# runs stemd — `cargo build` is the whole of it — but adding a model means
# opening a published PyTorch checkpoint once to convert its tensors, and the
# numbers in docs/evaluation.md come from scoring against MUSDB. Both need this
# environment, so pyproject.toml and uv.lock are tracked and tools/ goes with
# them.
#
# The environment those files create is still local.
__pycache__/
.venv/
*.egg-info/

# Bundled app
/dist/
/build/

# Traced/exported models: large, and regenerated by tools/export.
#
# Anchored, and the others here with it. Unanchored, this pattern matched every
# directory called `models` at any depth — including crates/stemd-server/src/
# models/, whose mod.rs, download.rs and integrity.rs were never committed
# because of it. A clone did not build and nothing said so.
/models/

# Audio in and out
/out/
*.wav
*.flac
*.aiff
*.mp3
*.m4a
!tests/fixtures/*.wav

# Finder droppings
.DS_Store

# Agent tooling state, including worktrees that are their own repositories
.claude/
