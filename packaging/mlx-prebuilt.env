# The prebuilt MLX that the Linux and Windows packages link, one per platform.
# .github/workflows/mlx-prebuilt.yml builds it and attaches it to the release
# named by MLX_PREBUILT_TAG; packaging/prebuilt.sh fetches and checks it.
#
# Changing an architecture list, the toolchain or the MLX pin needs a new tag
# and a new build. The list uses 90a: MLX builds its Hopper-only kernels for 90a
# alone. The SHA-256 lines come from the summary of the mlx-prebuilt.yml run.
MLX_PREBUILT_TAG=mlx-cuda-5
CUDA_ARCHS_linux_x86_64="75;80;86;89;90a;120"
CUDA_ARCHS_linux_aarch64="90a;100;121"
CUDA_ARCHS_windows_x86_64="75;80;86;89;90a;120"
SHA256_linux_x86_64=bf941bd14342dcd1809103fa25f92149d4cd90e02a824ac48206c76c084940d4
SHA256_linux_aarch64=ead8f1a706cb1b0944f87289040bfbc6b9da1d8014bf5c5326d880d702fdf375
SHA256_windows_x86_64=a7ddd82552e9ce1f71ff4dc9a29c11fa91207a9e0a2442d6ef539c2ee6cdf2cd
