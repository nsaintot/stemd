# The prebuilt MLX that the Linux and Windows packages link, one per platform.
# .github/workflows/mlx-prebuilt.yml builds it and attaches it to the release
# named by MLX_PREBUILT_TAG; packaging/prebuilt.sh fetches and checks it.
#
# Changing an architecture list, the toolchain or the MLX pin means a new tag
# and a new build. 90a rather than 90: MLX builds its Hopper-only kernels for
# 90a alone. The SHA-256 lines are filled in from that workflow's summary.
MLX_PREBUILT_TAG=mlx-cuda-3
CUDA_ARCHS_linux_x86_64="80;86;89;90a;120"
CUDA_ARCHS_linux_aarch64="90a;100;121"
CUDA_ARCHS_windows_x86_64="80;86;89;90a;120"
SHA256_linux_x86_64=40f1773f54e6c11fc90134d7f88f4aa7a708f8d250650f914b82112ea2457fb4
SHA256_linux_aarch64=47c9f69534de9a3785b6516821344b253d923d028635150b85852be53be869af
SHA256_windows_x86_64=8e12d261f29c38409509d31300fa3ed78e1efc46e4793c69f76fe09c79045f99
